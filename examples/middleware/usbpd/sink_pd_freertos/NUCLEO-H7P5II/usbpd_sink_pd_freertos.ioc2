        path: $SolutionDir()$/../generated/middleware/freertos
      - generator: usbpd_mx2codegen
        path: $SolutionDir()$/../generated/middleware/usbpd
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
