"File: open_bootloader_demo.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: NUCLEO-H7P5II
      board: NUCLEO-H7P5II:NUH7P5II$CR1
      device: STM32H7P5IIK6
  output-dirs:
    tmpdir: build/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: stm32h7pxx_hal_mx2codegen
        path: $SolutionDir()$/../generated/hal/
      - generator: syscalls_mx2codegen
        path: $SolutionDir()$/../generated/utilities/syscalls
      - generator: openbootloader_mx2codegen
        path: $SolutionDir()$/../generated/middleware/open_bootloader
      - generator: led_mx2codegen
        path: $SolutionDir()$/../generated/parts/led
      - generator: usbx_mx2codegen
        path: $SolutionDir()$/../generated/middleware/usbx
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/open_bootloader_demo.cproject.yml
  packs:
    - pack: STMicroelectronics::button_hw-part@2.2.0
    - pack: STMicroelectronics::CMSIS@6.3.0
    - pack: STMicroelectronics::crystal_hw-part@2.3.1
    - pack: STMicroelectronics::esd_hw-part@2.2.0
    - pack: STMicroelectronics::led_hw-part@2.5.0
    - pack: STMicroelectronics::led_part_drivers@2.2.0
    - pack: STMicroelectronics::level-shifter_hw-part@2.1.0
    - pack: STMicroelectronics::mcp2562fd_hw-part@2.1.0
    - pack: STMicroelectronics::nucleo-h7p5ii_hw-board@2.0.0
    - pack: STMicroelectronics::open_bootloader@7.1.0
    - pack: STMicroelectronics::st-link_hw-part@2.1.0
    - pack: STMicroelectronics::stm32h7pxx_dfp@2.0.0
    - pack: STMicroelectronics::stm32h7pxx_hal_drivers@2.0.0
    - pack: STMicroelectronics::syscalls@2.0.2
    - pack: STMicroelectronics::tcpp01-m12_hw-part@2.1.0
    - pack: STMicroelectronics::usbx@2.2.0
"""
