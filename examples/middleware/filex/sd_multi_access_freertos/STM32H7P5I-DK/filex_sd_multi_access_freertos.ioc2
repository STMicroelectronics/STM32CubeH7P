          "index": 7,
          "instanceId": "1f896fab-0cae-4d73-aa22-b7a6882ff11d",
          "entity": "unknown",
          "settings": {
            "parameters": {
              "info": {
                "description": "The syscalls utility provide minimal newlib/GCC integration with core syscall stubs and protected heap management for safe dynamic memory and standard library use."
              },
              "basic": {
