      "STMicroelectronics.stm32h7pxx_hal_drivers.2.0.0$STMicroelectronics::Device:STM32CubeMX2 Config:FMAC@2.0.0#HAL CORE DMA Init and FMAC": [
        {
          "index": 12,
          "instanceId": "fa0447ca-ed06-498a-bb16-01bc14dc6bfa",
          "entity": "peripheral.fmac",
          "settings": {
            "parameters": {
              "info": {
                "labels": [
                  "mx_example_fmac"
                ],
                "layer": "HAL",
                "init_type": "enabled",
                "explanation": "The X1 and X2 buffers are used to store data for input to the FMAC.\\nEach multiplication takes a value from the X1 buffer and a value from the X2 buffer and multiplies them together.\\nThe Y (output) buffer is used to store the output of an accumulation.\\nEach new output value is stored in the Y buffer until it is read by the processor or DMA controller"
              },
              "basic": {
                "buff_x1": {
                  "base_half_word": 5,
                  "size_half_word": 127
                },
                "buff_x2": {
                  "size_half_word": 5,
                  "base_half_word": 0
                },
                "buff_y": {
                  "size_half_word": 123,
                  "base_half_word": 132
                }
              },
              "additional": {
                "watermark": {
                  "x1_full": 1,
                  "y_empty": 1
                },
                "clipping_range": false
              },
              "system": {
                "dma": {
                  "enable_dma_write": false,
                  "enable_dma_read": true,
                  "dma_config_read": {
                    "needs": [
                      {
                        "needType": "need.dma.channels",
                        "projectUri": "cube:a150e323-41e2-4b6d-a07e-851767e12de3/81370042-60b9-430b-b326-4c3cd35377fd",
                        "componentId": "STMicroelectronics.stm32h7pxx_hal_drivers.2.0.0$STMicroelectronics::Device:STM32CubeMX2 Config:FMAC@2.0.0#HAL CORE DMA Init and FMAC",
