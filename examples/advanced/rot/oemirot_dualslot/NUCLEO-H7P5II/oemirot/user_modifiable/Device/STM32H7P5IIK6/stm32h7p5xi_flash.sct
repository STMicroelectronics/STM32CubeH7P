#! armclang -E --target=arm-arm-none-eabi -march=armv7-m -xc
; command above MUST be in first line (no comment above!)

; ******************************************************************************
; * @file    stm32h7p5xi_flash.sct
; * @brief   Linker File
; ******************************************************************************
